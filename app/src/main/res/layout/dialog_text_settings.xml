<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_text_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/input_text_edit_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/overlay_text_settings_enter" />

    <CheckBox
        android:id="@+id/input_text_edit_center"
        android:text="@string/overlay_text_settings_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</LinearLayout>
